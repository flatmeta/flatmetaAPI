# Copy to .env on the server and fill in every empty value. Never commit the real .env.
APP_NAME=FlatMeta
APP_ENV=production
APP_KEY=                       # php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.flatmeta.io/
FRONTEND_URL=https://flatmeta.io
TRUSTED_PROXIES=127.0.0.1
CORS_ALLOWED_ORIGINS=https://www.flatmeta.io

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flatmeta
DB_USERNAME=flatmeta
DB_PASSWORD=
DB_STRICT_MODE=false

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Sign-in codes are emailed: use a real provider (Mailgun, Postmark, SES, Zoho, Google Workspace SMTP...)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@flatmeta.io
MAIL_FROM_NAME="${APP_NAME}"

# PayPal LIVE app credentials (test everything with PAYPAL_MODE=sandbox first)
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_PLAN_ID=                # php artisan paypal:setup
PAYPAL_WEBHOOK_ID=             # from the webhook pointing at https://api.flatmeta.io/api/paypal/webhook
PAYPAL_CURRENCY=USD
PAYPAL_PAYOUTS_ENABLED=true
